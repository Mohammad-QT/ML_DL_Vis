---
// Placeholder home (Milestone 1). Milestone 2 ports sketches/home here.
import Base from '../layouts/Base.astro';
import Board from './Board.astro';
import { home, href, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = home[lang];
---
<Base lang={lang} title={lang === 'ar' ? 'الرئيسية' : 'Home'} description={t.lede.replace(/<[^>]+>/g, '')}>
  <section class="hero">
    <div>
      <h1 class="display" set:html={t.title} />
      <p class="lede" set:html={t.lede} />
      <a class="btn" href={href(lang, 'learn/3-classification/knn/')}><span set:html={t.cta} /> <span class="arr">→</span></a>
    </div>
    <figure class="sheet fp">
      <Board lang={lang} model="knn" variant="figure" preset="moons" seed={11} cell={4} dot={3.6} tint={0.24} height="220px" />
    </figure>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; padding: 40px 0 30px; }
  h1 { font-size: 62px; line-height: 1; margin-bottom: 14px; }
  .lede { font-size: 20px; color: var(--muted); max-width: 30em; margin-bottom: 22px; }
  .fp { padding: 12px; transform: rotate(1.2deg); }
  :global(html[dir="rtl"]) .fp { transform: rotate(-1.2deg); }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } h1 { font-size: 44px; } }
</style>
