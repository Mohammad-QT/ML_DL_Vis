---
import { fill, learn, lesson, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  stepsHeading: string;
  steps: string[];
  caution: { h: string; p: string };
  quick?: { steps: string[]; caution: string; scene: string; words?: Record<string, string> };
  previous?: { href: string; label: string };
  previousPlaceholder?: boolean;
  rich?: boolean;
}

const { lang, stepsHeading, steps, caution, quick, previous, previousPlaceholder, rich } = Astro.props;
const t = lesson[lang];
const l = learn[lang];
---
<section class="sheet card on learn-card" role="tabpanel" data-learn={quick?.scene} data-learn-words={quick?.words ? JSON.stringify(quick.words) : undefined}>
  {quick && (
    <>
      <div class="learn-heading" data-learn-heading hidden>
        <h2 class="display">{t.idea_h}</h2>
        <div class="seg learn-mode" role="radiogroup" aria-label={l.mode}>
          <button type="button" role="radio" data-learn-mode="simple" aria-checked="true">{l.simple}</button>
          <button type="button" role="radio" data-learn-mode="detailed" aria-checked="false" tabindex="-1">{l.detailed}</button>
        </div>
      </div>
      <div class="learn-simple" data-learn-simple hidden>
        <div class="learn-visual" data-learn-visual>
          <svg class="learn-scene" viewBox="0 0 400 300" direction="ltr" role="img" aria-label={l.animation}></svg>
        </div>
        <div class="learn-caption" data-learn-caption tabindex="0" role="group" aria-label={l.stepControls}>
          <button type="button" class="btn ghost learn-nav" data-learn-prev aria-label={l.prevStep}>
            <span class="arr" aria-hidden="true">←</span>
          </button>
          <div class="learn-caption-body" aria-live="polite" aria-atomic="true">
            <span class="learn-counter"><span data-learn-status dir="ltr" aria-label={fill(l.step, { n: 1, total: quick.steps.length })}>1 / {quick.steps.length}</span></span>
            <span class="learn-caption-text">
              {quick.steps.map((step, i) => (
                <span class="learn-step-copy" data-learn-step={i} hidden={i !== 0}><mark set:html={step} /></span>
              ))}
            </span>
          </div>
          <button type="button" class="btn ghost learn-nav" data-learn-next aria-label={l.nextStep}>
            <span class="arr" aria-hidden="true">→</span>
          </button>
        </div>
        <div class="learn-controls">
          <div class="learn-dots">
            {quick.steps.map((_, i) => (
              <button
                type="button"
                class:list={['learn-dot', { current: i === 0 }]}
                data-learn-dot={i}
                aria-label={fill(l.goToStep, { n: i + 1 })}
                aria-current={i === 0 ? 'step' : undefined}
              />
            ))}
          </div>
          <button type="button" class="chip learn-pause" data-learn-pause aria-pressed="false">{l.pause}</button>
        </div>
        <p class="learn-caution">{quick.caution}</p>
      </div>
    </>
  )}
  <div data-learn-detailed>
    <div class:list={['read', { rich }]}>
      <h2 class="display">{t.idea_h}</h2>
      <slot />
    </div>
    <h3 class="display" set:html={stepsHeading} />
    <ol class="how" style={`--cols:${steps.length}`}>{steps.map(step => <li set:html={step} />)}</ol>
    <div class="note read"><h3 class="display" style="margin-top:0" set:html={caution.h} /><p set:html={caution.p} /></div>
  </div>
  <div class="navrow">
    {previous
      ? <a class="btn ghost" data-learn-previous href={previous.href}><span class="arr">←</span> <span>{previous.label}</span></a>
      : previousPlaceholder && <span></span>}
    <button class="btn" data-goto="1"><span>{t.s2}</span> <span class="arr">→</span></button>
  </div>
</section>

<script>
  import { mountLearn } from '../learn/player';
  document.querySelectorAll<HTMLElement>('[data-learn]').forEach(root => void mountLearn(root));
</script>

<style>
  .card { display: none; padding: 34px 36px; }
  .card.on { display: block; animation: rise .3s ease; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  .card h2 { font-size: 34px; line-height: 1.1; margin-bottom: 12px; }
  .card h3 { font-size: 21px; margin: 26px 0 10px; }
  .read { max-width: 640px; }
  .read :global(p), .rich :global(ul) { margin-bottom: 12px; }
  .rich :global(ul) { padding-inline-start: 22px; }
  .rich :global(li) { margin-bottom: 6px; }
  .rich :global(h3.display) { font-size: 21px; margin: 26px 0 10px; }
  .card :global(code) { font: 500 .86em var(--mono); background: var(--paper); padding: 1px 6px; border-radius: 5px; }
  .how { list-style: none; display: grid; grid-template-columns: repeat(var(--cols, 4), 1fr); gap: 12px; counter-reset: s; }
  .how li { counter-increment: s; background: var(--paper); border-radius: 14px; padding: 14px; font-size: 15.5px; line-height: 1.45; }
  .how li::before { content: counter(s); display: block; font: 600 13px var(--mono); color: var(--muted); margin-bottom: 6px; }
  .note { margin-top: 22px; border-inline-start: 4px solid var(--hl); padding: 4px 0 4px 16px; }
  :global(html[dir="rtl"]) .note { padding: 4px 16px 4px 0; }
  .navrow { display: flex; justify-content: space-between; margin-top: 28px; }

  .learn-heading:not([hidden]) { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .learn-heading h2 { margin: 0; }
  .learn-card[data-mode="detailed"] { position: relative; }
  .learn-card[data-mode="detailed"] .learn-heading { position: absolute; inset-block-start: 34px; inset-inline-end: 36px; margin: 0; }
  .learn-card[data-mode="detailed"] .learn-heading h2 { display: none; }
  .learn-mode { flex: none; overflow: visible; }
  .learn-mode button { border-radius: 8px; min-height: 34px; font-family: var(--body); }
  .learn-simple:not([hidden]) { display: grid; gap: 14px; }
  .learn-visual { min-width: 0; background: var(--sheet); }
  .learn-scene { display: block; width: 100%; max-height: 60vh; aspect-ratio: 4 / 3; direction: ltr; touch-action: pan-y; background: var(--paper); border: 1.5px solid var(--rule); border-radius: 14px; }
  .learn-scene :global(text) { font-family: var(--body); }
  .learn-scene :global(.scene-value) { font-family: var(--mono); }
  .learn-scene :global(.scene-tween),
  .learn-scene :global(.scene-slow) {
    transition:
      opacity .9s ease-in-out,
      fill .9s ease-in-out,
      stroke .9s ease-in-out,
      stroke-dashoffset .9s ease-in-out,
      stroke-width .9s ease-in-out,
      transform .9s ease-in-out;
    transition-delay: var(--delay, 0ms);
  }
  .learn-scene :global(.scene-slow) { transition-duration: 1.4s; }
  .learn-scene :global(.scene-filter) { transition: x .06s linear, y .06s linear; }
  /* The player rewinds a held step instantly before replaying it. */
  .learn-scene:global(.learn-instant), .learn-scene:global(.learn-instant) :global(*) { transition: none !important; transition-delay: 0s !important; }
  .learn-caption { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1.5px solid var(--rule); border-radius: 14px; background: var(--paper); }
  .learn-nav { min-width: 44px; min-height: 44px; padding: 8px 14px; justify-content: center; flex: none; box-shadow: 0 3px 0 var(--lift); }
  .learn-caption-body { flex: 1; min-width: 0; text-align: center; font: 600 18px/1.45 var(--body); color: var(--ink); overflow-wrap: anywhere; }
  .learn-counter { display: inline-block; unicode-bidi: isolate; font: 600 14px var(--mono); color: var(--muted); margin-inline-end: 8px; white-space: nowrap; }
  .learn-counter [data-learn-status] { direction: ltr; unicode-bidi: isolate; }
  .learn-caption-text { unicode-bidi: isolate; }
  .learn-caption-text mark { padding-inline: .14em; background-size: 100% 100%; transition-delay: 0s; }
  .learn-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; color: var(--muted); font-size: 13px; }
  .learn-dots { display: flex; align-items: center; gap: 2px; }
  .learn-dot { width: 44px; height: 44px; padding: 0; border: 0; border-radius: 10px; background: none; display: grid; place-items: center; cursor: pointer; }
  .learn-dot::before { content: ''; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--muted); background: transparent; transition: background-color .15s, border-color .15s, transform .15s; }
  .learn-dot:hover::before { border-color: var(--ink); }
  .learn-dot.current::before { background: var(--ink); border-color: var(--ink); transform: scale(1.2); }
  .learn-pause { margin-inline-start: auto; min-height: 44px; padding: 6px 14px; }
  .learn-pause:disabled { opacity: .45; color: var(--muted); cursor: default; }
  .learn-caution { margin-top: 2px; border-inline-start: 4px solid var(--hl); padding-inline-start: 10px; color: var(--muted); font-size: 15px; }
  .learn-card[data-mode="simple"] .navrow { justify-content: flex-end; }
  [data-learn-previous][hidden] { display: none; }

  @media (max-width: 860px) {
    .card { padding: 22px; }
    .how { grid-template-columns: 1fr 1fr; }
    .learn-card[data-mode="detailed"] .learn-heading { inset-block-start: 22px; inset-inline-end: 22px; }
  }
  @media (max-width: 600px) {
    .learn-scene { max-height: none; }
    .learn-caption { gap: 8px; padding: 8px 10px; }
    .learn-caption-body { font-size: 16px; }
  }
  @media (max-width: 340px) {
    .learn-card[data-mode="detailed"] .learn-heading { position: static; justify-content: flex-end; margin-bottom: 8px; }
  }
</style>
