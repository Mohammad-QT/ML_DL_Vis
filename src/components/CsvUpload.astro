---
// "Your CSV" panel, shown inside the Compare page's data card when its tab is picked.
// The logic lives in src/csvui.ts; the CSV never leaves the browser.
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; t: Record<string, string> }
const { t } = Astro.props;
const samples = [['customers.csv', t.c_s_customers], ['mpg.csv', t.c_s_mpg]];
---
<div class="csv" id="csv" data-csv hidden>
  <div class="csv-row">
    <label class="btn ghost csv-pick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7zM14 3v4h4M12 17v-6m0 0-3 3m3-3 3 3"/></svg>{t.c_upload}<input type="file" accept=".csv,text/csv,text/plain,.tsv,.txt" hidden></label>
    <span class="csv-try">{t.c_try}{" "}
      {samples.map(([f, label], i) => <Fragment>{i > 0 && ' · '}<a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}samples/${f}`} download={f} data-sample={f}>{label}</a></Fragment>)}
    </span>
  </div>
  <p class="muted csv-private"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{t.c_private}</p>
  <div class="csv-fields" hidden>
    <p class="csv-file"><span class="muted">{t.c_file}</span> <bdi class="csv-name mono"></bdi></p>
    <div class="csv-grid">
      <label><span class="label">{t.c_target}</span><select class="csv-t"></select></label>
      <label><span class="label">{t.c_f1}</span><select class="csv-f1"></select></label>
      <label><span class="label">{t.c_f2}</span><select class="csv-f2"></select></label>
    </div>
    <label class="csv-check"><input type="checkbox" class="csv-pca"> {t.c_pca}</label>
    <p class="csv-task muted" aria-live="polite"></p>
  </div>
  <ul class="csv-msg muted" hidden aria-live="polite"></ul>
  <p class="csv-err" role="alert" hidden></p>
</div>

<style>
  .csv { margin-top: 14px; padding-top: 14px; border-top: 1.5px dashed var(--rule); }
  .csv[hidden], .csv-fields[hidden], .csv-msg[hidden], .csv-err[hidden] { display: none; }
  .csv-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .csv-pick { cursor: pointer; font-size: 15px; padding: 7px 14px; box-shadow: 0 3px 0 var(--lift); }
  .csv-pick svg { width: 17px; height: 17px; }
  .csv-pick:focus-within { outline: 3px solid var(--a); outline-offset: 2px; }
  .csv-try { font-size: 14.5px; }
  .csv-private { display: flex; align-items: center; gap: 6px; font-size: 13.5px; margin-top: 8px; }
  .csv-private svg { width: 14px; height: 14px; flex: none; }
  .csv-fields { margin-top: 12px; }
  .csv-file { font-size: 14px; margin-bottom: 8px; }
  .csv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .csv-grid label { display: block; }
  .csv-grid select { width: 100%; appearance: none; border: 1.5px solid var(--rule); background: var(--paper); color: var(--ink); font: 500 14px var(--mono); padding: 8px 34px 8px 12px; border-radius: 10px; cursor: pointer; margin-top: 4px;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%); background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%; background-size: 5px 5px; background-repeat: no-repeat; }
  :global(html[dir="rtl"]) .csv-grid select { padding: 8px 12px 8px 34px; background-position: 18px 55%, 13px 55%; }
  .csv-grid select:disabled { opacity: .45; cursor: not-allowed; }
  .csv-check { display: flex; gap: 8px; align-items: center; margin-top: 10px; font-size: 15px; cursor: pointer; }
  .csv-check input { width: 18px; height: 18px; accent-color: var(--a); }
  .csv-task { font-size: 15px; margin-top: 8px; }
  .csv-msg { margin: 10px 0 0; padding-inline-start: 20px; font-size: 14.5px; }
  .csv-err { margin-top: 10px; padding: 10px 14px; border-radius: 10px; border: 1.5px solid var(--bad); color: var(--ink); background: color-mix(in srgb, var(--bad) 10%, var(--sheet)); font-size: 15px; }
  @media (max-width: 700px) { .csv-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
