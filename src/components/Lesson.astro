---
// The lesson template: one page per classification lesson, filled from the MDX entry in src/content/lessons/.
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CourseNav from './CourseNav.astro';
import PartProgress from './PartProgress.astro';
import StepOf from './StepOf.astro';
import CheckFlow from './CheckFlow.astro';
import CodeOptions from './CodeOptions.astro';
import NextLesson from './NextLesson.astro';
import Board from './Board.astro';
import { href, common, lesson, type Lang } from '../i18n/ui';
import { MODELS, type ModelName } from '../engine';
import { CLASSIFICATION, lessonPath, regPath } from '../lessons';

interface Props { lang: Lang; entry: CollectionEntry<'lessons'> }
const { lang, entry } = Astro.props;
const d = entry.data;
const c = common[lang];
const t = lesson[lang];
const name = (id: string) => c[`m_${id}` as keyof typeof c];
const fill = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k]));
const n = CLASSIFICATION.indexOf(d.model as never) + 1;
const prev = CLASSIFICATION[n - 2];
const paramName = Object.keys(MODELS[d.model as ModelName].params)[0] ?? '';
const steps = [t.s1, t.s2, t.s3, t.s4];
const key = `3/${d.model}`;
const partId = '3' as const;
const shape = c[`s_${d.model}` as keyof typeof c];
const play = d.play;
const hl = (code: string) => code.replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/\b(from|import)\b|\b\d+(?:\.\d+)?\b/g, (m, kw) => `<span class="${kw ? 'k' : 'n'}">${m}</span>`);
---
<Base lang={lang} title={d.short} description={d.lede}>
  <nav class="crumbs" slot="crumbs"><a href={href(lang)}>{c.nav_course}</a> / <span>{t.crumb_part}</span></nav>
  <PartProgress slot="bar" lang={lang} part={partId} />
  <CourseNav slot="rail" lang={lang} current={key} />

  <section class="hero">
    <div>
      <div class="kicker">{fill(t.kicker, { n })}</div>
      <h1 class="display" set:html={d.title} />
      <p class="lede">{d.lede}</p>
    </div>
    <figure class="sheet fp">
      <Board lang={lang} model={d.model as never} variant="figure" preset={d.figure.preset} seed={d.figure.seed} cell={d.figure.cell} dot={d.figure.dot} tint={d.figure.tint} />
      <figcaption><span>{t.fp_cap}</span> <b>{shape}</b></figcaption>
    </figure>
  </section>

  <div class="tabs" role="tablist">
    {steps.map((s, i) => (
      <button class:list={['tab', { on: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-step={i}><span class="n">{i + 1}</span><span>{s}</span></button>
    ))}
    <StepOf lang={lang} />
  </div>

  <section class="sheet card on" role="tabpanel">
    <div class="read">
      <h2 class="display">{t.idea_h}</h2>
      <slot />
    </div>
    <h3 class="display" set:html={t.steps_h} />
    <ol class="how" style={`--cols:${d.steps.length}`}>{d.steps.map(s => <li set:html={s} />)}</ol>
    <div class="note read"><h3 class="display" style="margin-top:0" set:html={d.caution.h} /><p set:html={d.caution.p} /></div>
    <div class="navrow">
      {prev
        ? <a class="btn ghost" href={href(lang, lessonPath(prev))}><span class="arr">←</span> <span>{fill(t.prev, { m: name(prev) })}</span></a>
        : <a class="btn ghost" href={href(lang, regPath('forest'))}><span class="arr">←</span> <span>{fill(t.prev, { m: name('forest') })}</span></a>}
      <button class="btn" data-goto="1"><span>{t.s2}</span> <span class="arr">→</span></button>
    </div>
  </section>

  <section class="sheet card" role="tabpanel">
    <h2 class="display">{t.play_h}</h2>
    <p class="muted read"><span class="on-mouse">{play.p}</span><span class="on-touch">{play.p_touch ?? play.p}</span></p>
    <Board lang={lang} model={d.model as never} preset={play.preset} seed={play.seed} paramLabel={play.param_label}
      hints={{ low: play.hints.low && { max: play.hints.low.max, text: play.hints.low.text }, high: play.hints.high && { min: play.hints.high.min, text: play.hints.high.text } }} />
    <div class="navrow"><button class="btn ghost" data-goto="0"><span class="arr">←</span> <span>{t.s1}</span></button><button class="btn" data-goto="2"><span>{t.s3}</span> <span class="arr">→</span></button></div>
  </section>

  <section class="sheet card" role="tabpanel">
    <CheckFlow lang={lang} quiz={d.quiz} heading={t.quiz_h}>
      <div slot="predict">
        <h3 class="display">{t.predict_h}</h3>
        <p class="muted read">{t.predict_p}</p>
        <div class="predict" data-correct={d.predict.answer}>
          <div class="pdata"><Board lang={lang} variant="figure" preset={d.predict.preset} seed={d.predict.seed} height="230px" /></div>
          <div class="opts">{d.predict.options.map((o, i) => (
            <button class="opt" data-opt={i} aria-label={name(o)}>
              <Board lang={lang} model={o as never} variant="figure" preset={d.predict.preset} seed={d.predict.seed} height="150px" cell={4} dot={3} tint={0.22} />
              <span class="nm"><span class="tag"></span><b>{name(o)}</b></span>
            </button>
          ))}</div>
          <p class="fb" aria-live="polite" data-pfb data-why={d.predict.why}></p>
        </div>
      </div>
      {d.beat && <div slot="beat">
        <h3 class="display">{t.beat_h}</h3>
        <p class="muted read">{t.beat_p}</p>
        <Board lang={lang} model={d.model as never} preset={d.beat.preset} seed={d.beat.seed} params={{ [paramName]: d.beat.start }} challenge={{ target: d.beat.target }} paramLabel={play.param_label} />
      </div>}
    </CheckFlow>
  </section>

  <section class="sheet card" role="tabpanel">
    <div class="read">
      <h2 class="display">{t.code_h}</h2>
      <p class="muted">{t.code_p}</p>
<pre set:html={hl(d.code)} />
      <CodeOptions lang={lang} current={key}>
        <a class="btn ghost" href={href(lang, `compare/?a=${d.model}&b=${d.compare}`)}><span>{fill(t.compare_cta, { m: d.short })}</span> <span class="arr">→</span></a>
      </CodeOptions>
    </div>
    <NextLesson lang={lang} current={key} />
    <div class="navrow"><button class="btn ghost" data-goto="2"><span class="arr">←</span> <span>{t.s3}</span></button></div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: end; padding: 26px 0 30px; }
  .kicker { font: 600 13px var(--mono); color: var(--muted); }
  h1 { font-size: 68px; line-height: .98; margin: 12px 0 14px; }
  .lede { font-size: 20px; color: var(--muted); max-width: 30em; }
  .fp { padding: 12px; transform: rotate(1.2deg); }
  :global(html[dir="rtl"]) .fp { transform: rotate(-1.2deg); }
  .fp figcaption { font: 500 13px var(--mono); color: var(--muted); padding: 10px 4px 2px; }
  .fp figcaption b { color: var(--ink); font-family: var(--body); font-size: 15px; }


  .tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .tab { display: flex; align-items: center; gap: 9px; border: 1.5px solid var(--rule); background: var(--sheet); color: var(--muted); font: 700 16px var(--body); padding: 8px 18px 8px 9px; border-radius: 13px; cursor: pointer; box-shadow: 0 3px 0 var(--lift); transition: transform .12s; }
  :global(html[dir="rtl"]) .tab { padding: 8px 9px 8px 18px; }
  .tab:hover { transform: translateY(-2px); }
  .tab .n { width: 25px; height: 25px; border-radius: 8px; display: grid; place-items: center; font: 600 13px var(--mono); background: var(--paper); }
  .tab.on { background: var(--ink); color: var(--sheet); border-color: var(--ink); }
  .tab.on .n { background: var(--hl); color: #15202b; }
  .tab.done .n { background: var(--ok); color: #fff; }

  .card { display: none; padding: 34px 36px; }
  .card.on { display: block; animation: rise .3s ease; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  .card h2 { font-size: 34px; line-height: 1.1; margin-bottom: 12px; }
  .card h3 { font-size: 21px; margin: 26px 0 10px; }
  .read { max-width: 640px; }
  .read p { margin-bottom: 12px; }
  .card :global(code) { font: 500 .86em var(--mono); background: var(--paper); padding: 1px 6px; border-radius: 5px; }
  .how { list-style: none; display: grid; grid-template-columns: repeat(var(--cols, 4), 1fr); gap: 12px; counter-reset: s; }
  .how li { counter-increment: s; background: var(--paper); border-radius: 14px; padding: 14px; font-size: 15.5px; line-height: 1.45; }
  .how li::before { content: counter(s); display: block; font: 600 13px var(--mono); color: var(--muted); margin-bottom: 6px; }
  .note { margin-top: 22px; border-inline-start: 4px solid var(--hl); padding: 4px 0 4px 16px; }
  :global(html[dir="rtl"]) .note { padding: 4px 16px 4px 0; }


  .predict { margin-top: 14px; }
  .pdata { border: 1.5px solid var(--rule); border-radius: 16px; padding: 8px; background: var(--sheet); max-width: 420px; }
  .opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 14px; }
  .opt { text-align: start; border: 1.5px solid var(--rule); background: var(--sheet); color: var(--ink); border-radius: 14px; padding: 8px; font: 700 15px var(--body); cursor: pointer; box-shadow: 0 3px 0 var(--lift); transition: transform .12s; }
  .opt:hover { transform: translateY(-2px); }
  .opt .nm { display: block; min-height: 22px; padding: 8px 4px 0; visibility: hidden; }
  .opt .tag { font: 600 12px var(--mono); margin-inline-end: 6px; }
  .predict.done .opt { cursor: default; transform: none; }
  .predict.done .opt .nm { visibility: visible; }
  .opt.right { border-color: var(--ok); box-shadow: 0 3px 0 var(--ok); }
  .opt.wrong { border-color: var(--bad); box-shadow: 0 3px 0 var(--bad); }
  .opt.right .tag { color: var(--ok); } .opt.wrong .tag { color: var(--bad); }

  .navrow { display: flex; justify-content: space-between; margin-top: 28px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; } h1 { font-size: 46px; }
    .how { grid-template-columns: 1fr 1fr; }
    /* compact so the whole "predict the line" card fits a phone screen */
    .pdata { max-width: none; padding: 6px; }
    .pdata :global(canvas) { height: 170px !important; }
    .opts { gap: 8px; margin-top: 10px; }
    .opt { padding: 5px; border-radius: 12px; }
    .opt :global(canvas) { height: 88px !important; border-radius: 8px; }
    .opt .nm { font-size: 12.5px; line-height: 1.25; padding: 6px 2px 0; min-height: 0; }
    .card { padding: 22px; }
    :global(.crumbs) { display: none; }
  }
</style>

<script>
  const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
  const tabs = $$('.tab'), cards = $$('.card');
  const lit = (el: HTMLElement) => { el.classList.remove('lit'); requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('lit'))); };

  function go(i: number) {
    tabs.forEach((t, j) => { t.classList.toggle('on', j === i); t.setAttribute('aria-selected', String(j === i)); if (j < i) t.classList.add('done'); });
    cards.forEach((c, j) => c.classList.toggle('on', j === i));
    lit(cards[i]);
  }
  tabs.forEach(t => t.addEventListener('click', () => go(Number(t.dataset.step))));
  $$('[data-goto]').forEach(b => b.addEventListener('click', () => go(Number(b.dataset.goto))));

  go(0);
</script>
