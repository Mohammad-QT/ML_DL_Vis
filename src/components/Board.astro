---
// A live classification board. `variant="play"` is the full playground (scores, setting slider,
// class picker, presets); `variant="figure"` is a small static drawing of one model on fixed data.
import { MODELS, defaults, type ModelName, type ParamSpec, type Params, type PresetName } from '../engine';
import { common, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  model: ModelName;
  params?: Params;
  preset?: PresetName;
  /** Fixed seed for the starting data. Presets picked later are random. */
  seed?: number;
  variant?: 'play' | 'figure';
  /** Label for the model's tunable setting (the first entry in its params). */
  paramLabel?: string;
  /** Hint under the slider when the value is at or below `low.max` / at or above `high.min`. */
  hints?: { low?: { max: number; text: string }; high?: { min: number; text: string } };
  height?: string;
  cell?: number;
  dot?: number;
  tint?: number;
}
const {
  lang, model, preset = 'blobs', seed = 3, variant = 'play', paramLabel, hints = {},
  height = variant === 'figure' ? '190px' : '440px', cell, dot, tint,
} = Astro.props;
const t = common[lang];
const params = { ...defaults(model), ...Astro.props.params };
const specs: Record<string, ParamSpec> = MODELS[model].params;
const paramName = Object.keys(specs)[0];
const spec = paramName ? specs[paramName] : undefined;
const config = { model, params, preset, seed, variant, paramName, hints, cell, dot, tint };
const presets = ['blobs', 'moons', 'circles', 'xor'] as const;
---
{variant === 'figure' ? (
  <canvas class="board" data-board data-config={JSON.stringify(config)} style={`height:${height};cursor:default`} aria-hidden="true"></canvas>
) : (
  <div class="play" data-board data-config={JSON.stringify(config)}>
    <div class="frame">
      <canvas class="board" style={`height:${height}`}></canvas>
      <div class="under"><span>{t.hint_add}</span></div>
    </div>
    <div class="side">
      <div class="box scores" aria-live="polite">
        <div><small>{t.train}</small><div class="num" data-role="train">–</div></div>
        <div><small>{t.test}</small><div class="num" data-role="test">–</div></div>
      </div>
      {spec && (
        <label class="box">
          <span class="label">{paramLabel ?? paramName} · <b data-role="pval">{params[paramName]}</b></span>
          <input type="range" data-role="param" min={spec.min} max={spec.max} step={spec.step} value={params[paramName]}>
          <div class="hint" data-role="hint"></div>
        </label>
      )}
      <div class="box"><span class="label">{t.adding}</span><div class="chips">
        <button class="chip on" data-cls="0"><span class="swatch a"></span><span>{t.cls_a}</span></button>
        <button class="chip" data-cls="1"><span class="swatch b"></span><span>{t.cls_b}</span></button>
      </div></div>
      <div class="box"><span class="label">{t.data}</span><div class="chips">
        {presets.map(p => <button class:list={['chip', { on: p === preset }]} data-preset={p}>{t[`d_${p}`]}</button>)}
        <button class="chip" data-role="resplit">{t.resplit}</button>
        <button class="chip" data-role="clear">{t.clear}</button>
      </div></div>
      <p class="legend"><span class="swatch ring"></span><span>{t.legend_test}</span></p>
    </div>
  </div>
)}

<style>
  .play { display: grid; grid-template-columns: 1fr 250px; gap: 20px; margin-top: 16px; }
  .frame { border: 1.5px solid var(--rule); border-radius: 16px; padding: 8px; background: var(--sheet); }
  .under { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--muted); padding: 10px 6px 2px; }
  .side { display: flex; flex-direction: column; gap: 12px; }
  .box { display: block; background: var(--paper); border-radius: 14px; padding: 12px 14px; }
  .scores { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .scores .num { font: 600 30px/1 var(--mono); }
  .scores small { font: 500 12px var(--mono); color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .hint { font-size: 13.5px; line-height: 1.4; margin-top: 8px; min-height: 38px; color: var(--muted); }
  .legend { font-size: 13px; color: var(--muted); line-height: 1.4; }
  @media (max-width: 860px) {
    .play { grid-template-columns: 1fr; }
    .play canvas { height: 340px !important; }
  }
</style>

<script>
  import { Board } from '../engine/board';
  import { Store, fitModel, score, pct, isPreset, type ModelName, type Params, type PresetName, type Label } from '../engine';

  interface Config {
    model: ModelName; params: Params; preset: PresetName; seed: number; variant: 'play' | 'figure';
    paramName?: string; hints: { low?: { max: number; text: string }; high?: { min: number; text: string } };
    cell?: number; dot?: number; tint?: number;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-board]')) {
    const cfg: Config = JSON.parse(root.dataset.config!);
    const style = { cell: cfg.cell, dot: cfg.dot, tint: cfg.tint };

    if (cfg.variant === 'figure') {
      // fixed data, every point trains: a fingerprint of the model's line
      const store = new Store();
      const board = new Board(root as HTMLCanvasElement, store, { static: true, ...style });
      store.preset(cfg.preset, cfg.seed);
      store.points.forEach(p => (p.test = false));
      board.setModel(fitModel(cfg.model, cfg.params, store.points));
      continue;
    }

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s);
    const $$ = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const params = { ...cfg.params };
    let cls: Label = 0;

    const store = new Store({ testFrac: 0.25 });
    const board = new Board($<HTMLCanvasElement>('canvas')!, store, {
      ...style,
      onAdd: (p, e) => store.add(p.x, p.y, (e.shiftKey ? 1 - cls : cls) as Label),
    });
    const refit = () => {
      const m = fitModel(cfg.model, params, store.train());
      board.setModel(m);
      $('[data-role="train"]')!.textContent = pct(score(m, store.train()));
      $('[data-role="test"]')!.textContent = pct(score(m, store.test()));
    };
    store.subscribe(refit);

    const slider = $<HTMLInputElement>('[data-role="param"]');
    if (slider && cfg.paramName) {
      const name = cfg.paramName;
      const showHint = () => {
        const v = params[name], { low, high } = cfg.hints;
        $('[data-role="hint"]')!.textContent = low && v <= low.max ? low.text : high && v >= high.min ? high.text : '';
      };
      slider.addEventListener('input', () => {
        params[name] = Number(slider.value);
        $('[data-role="pval"]')!.textContent = slider.value;
        showHint();
        refit();
      });
      showHint();
    }

    $$('[data-cls]').forEach(b => b.addEventListener('click', () => {
      cls = Number(b.dataset.cls) as Label;
      $$('[data-cls]').forEach(x => x.classList.toggle('on', x === b));
    }));
    $$('[data-preset]').forEach(b => b.addEventListener('click', () => {
      const name = b.dataset.preset!;
      if (!isPreset(name)) return;
      store.preset(name);
      $$('[data-preset]').forEach(x => x.classList.toggle('on', x === b));
    }));
    $('[data-role="resplit"]')!.addEventListener('click', () => store.resplit());
    $('[data-role="clear"]')!.addEventListener('click', () => {
      store.clear();
      $$('[data-preset]').forEach(x => x.classList.remove('on'));
    });

    store.preset(cfg.preset, cfg.seed);
  }
</script>
