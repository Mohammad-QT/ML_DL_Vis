---
// A live classification board. `variant="play"` is the full playground (scores, setting slider,
// class picker, presets); `variant="figure"` is a small static drawing of one model on fixed data.
import { MODELS, defaults, type ModelName, type ParamSpec, type Params, type PresetName } from '../engine';
import { common, type Lang } from '../i18n/ui';
import Dock from './Dock.astro';
import BottomSheet from './BottomSheet.astro';
import { ICON } from '../ui/icons';

interface Props {
  lang: Lang;
  /** Omit with `variant="figure"` to draw just the data, no model. */
  model?: ModelName;
  params?: Params;
  preset?: PresetName;
  /** Fixed seed for the starting data. Presets picked later are random. */
  seed?: number;
  variant?: 'play' | 'figure';
  /** "Beat the score": data is fixed, only the setting slider is live, and reaching `target` (0-100) test accuracy wins. */
  challenge?: { target: number };
  /** Label for the model's tunable setting (the first entry in its params). */
  paramLabel?: string;
  /** Hint under the slider when the value is at or below `low.max` / at or above `high.min`. */
  hints?: { low?: { max: number; text: string }; high?: { min: number; text: string } };
  height?: string;
  cell?: number;
  dot?: number;
  tint?: number;
}
const {
  lang, model, preset = 'blobs', seed = 3, variant = 'play', challenge, paramLabel, hints = {},
  height = variant === 'figure' ? '190px' : '440px', cell, dot, tint,
} = Astro.props;
const t = common[lang];
const params = model ? { ...defaults(model), ...Astro.props.params } : {};
const specs: Record<string, ParamSpec> = model ? MODELS[model].params : {};
const paramName = Object.keys(specs)[0];
const spec = paramName ? specs[paramName] : undefined;
const log = !!spec?.log;
/** Settings marked `log` are log10 values: show the real number, e.g. 10 instead of 1. */
const show = (v: number) => (log ? String(Number((10 ** v).toPrecision(2))) : String(v));
const config = { model, params, preset, seed, variant, paramName, hints, cell, dot, tint, log, target: challenge?.target };
const presets = ['blobs', 'moons', 'circles', 'xor'] as const;
const uid = `pg${Math.random().toString(36).slice(2, 8)}`;
---
{variant === 'figure' ? (
  <canvas class="board" data-board data-config={JSON.stringify(config)} style={`height:${height};cursor:default`} aria-hidden="true"></canvas>
) : (
  <div class="play pg" data-board data-config={JSON.stringify(config)}>
    <div class="frame">
      <canvas class="board" role="img" aria-label={t.board_label} style={`height:${height}`}></canvas>
      <div class="hud" aria-hidden="true"><span>{t.train}<b data-role="train">–</b></span><span>{t.test}<b data-role="test">–</b></span></div>
      <div class="under"><span class="on-mouse">{t.hint_add}</span><span class="on-touch">{t.hint_tap}</span></div>
    </div>
    <div class="side">
      {!challenge && <p class="tip">{t.tip_dock}</p>}
      <div class="box scores" aria-live="polite">
        <div><small>{t.train}</small><div class="num" data-role="train">–</div></div>
        <div><small>{t.test}</small><div class="num" data-role="test">–</div></div>
      </div>
      {spec && (
        <div class="box pbox">
          <label class="pctl" data-phone="param">
            <span class="label"><span>{paramLabel ?? paramName}</span> <span class="sep">·</span> <b data-role="pval">{show(params[paramName])}</b></span>
            <input type="range" data-role="param" min={spec.min} max={spec.max} step={spec.step} value={params[paramName]}>
          </label>
          <div class="hint" data-role="hint"></div>
        </div>
      )}
      {!spec && <div class="box"><span class="hint">{t.p_none}</span></div>}
      {challenge && (
        <div class="box goal">
          <span class="label">{t.goal}</span>
          <div class="num">{t.goal_test.replace('{t}', String(challenge.target))}</div>
          <p class="win" data-role="win" hidden>{t.win}</p>
          <p class="win" data-role="won" hidden>{t.win_before}</p>
        </div>
      )}
      {!challenge && <><div class="box clsbox"><span class="label">{t.adding}</span><div class="chips">
        <button class="chip on" data-cls="0" aria-pressed="true"><span class="swatch a"></span><span>{t.cls_a}</span></button>
        <button class="chip" data-cls="1" aria-pressed="false"><span class="swatch b"></span><span>{t.cls_b}</span></button>
      </div></div>
      <div class="box databox" data-phone="data"><span class="label">{t.data}</span><div class="chips">
        {presets.map(p => <button class:list={['chip', { on: p === preset }]} data-preset={p}>{t[`d_${p}`]}</button>)}
        <button class="chip" data-role="resplit">{t.resplit}</button>
        <button class="chip" data-role="clear">{t.clear}</button>
        <button class="chip" data-role="undo" disabled>{t.undo}</button>
      </div></div></>}
      <p class="legend"><span class="swatch ring"></span><span>{t.legend_test}</span></p>
    </div>
    <Dock label={t.board_label.split('.')[0]}>
      {spec && <div class="dk-param" data-slot="param"></div>}
      <div class="dk-row">
        {!challenge && <button type="button" class="dbtn grow flip" data-role="flip" aria-label={t.flip.replace('{c}', t.cls_a)} data-label={t.flip}><span class="swatch a"></span><span class="nm">{t.cls_a}</span></button>}
        {challenge && <span class="grow"></span>}
        {!challenge && <button type="button" class="dbtn" data-role="undo" disabled aria-label={t.undo} title={t.undo}><Fragment set:html={ICON.undo} /></button>}
        <button type="button" class="dbtn" data-role="full" aria-pressed="false" aria-label={t.full} title={t.full} data-off={t.full_exit}><Fragment set:html={ICON.full} /></button>
        {!challenge && <button type="button" class="dbtn" data-sheet-open={`${uid}-data`} aria-expanded="false" aria-controls={`${uid}-data`}><span>{t.data_more}</span><Fragment set:html={ICON.down} /></button>}
      </div>
    </Dock>
    {!challenge && <BottomSheet id={`${uid}-data`} title={t.data} closeLabel={t.close}><div data-slot="data"></div></BottomSheet>}
  </div>
)}

<style>
  .play { display: grid; grid-template-columns: 1fr 250px; gap: 20px; margin-top: 16px; }
  .frame { position: relative; border: 1.5px solid var(--rule); border-radius: 16px; padding: 8px; background: var(--sheet); }
  .pctl { display: block; }
  .under { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--muted); padding: 10px 6px 2px; }
  .side { display: flex; flex-direction: column; gap: 12px; }
  .box { display: block; background: var(--paper); border-radius: 14px; padding: 12px 14px; }
  .scores { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .scores .num { font: 600 30px/1 var(--mono); }
  .scores small { font: 500 12px var(--mono); color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .hint { font-size: 13.5px; line-height: 1.4; margin-top: 8px; min-height: 38px; color: var(--muted); }
  .legend { font-size: 13px; color: var(--muted); line-height: 1.4; }
  @media (max-width: 860px) {
    .play { grid-template-columns: 1fr; }
    .play canvas { height: 340px !important; }
  }
</style>

<script>
  import { Board } from '../engine/board';
  import { Store, UndoStack, fitModel, score, pct, isPreset, type ModelName, type Params, type PresetName, type Label, type Point } from '../engine';
  import { mountPlayDock } from '../ui/playdock';

  interface Config {
    model?: ModelName; params: Params; preset: PresetName; seed: number; variant: 'play' | 'figure';
    paramName?: string; hints: { low?: { max: number; text: string }; high?: { min: number; text: string } };
    cell?: number; dot?: number; tint?: number; log?: boolean; target?: number;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-board]')) {
    const cfg: Config = JSON.parse(root.dataset.config!);
    const style = { cell: cfg.cell, dot: cfg.dot, tint: cfg.tint };

    if (cfg.variant === 'figure' || !cfg.model) {
      // fixed data, every point trains: a fingerprint of the model's line
      const store = new Store();
      const board = new Board(root as HTMLCanvasElement, store, { static: true, ...style });
      store.preset(cfg.preset, cfg.seed);
      store.points.forEach(p => (p.test = false));
      if (cfg.model) board.setModel(fitModel(cfg.model, cfg.params, store.points));
      continue;
    }

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s);
    const $$ = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const model = cfg.model;
    const params = { ...cfg.params };
    let cls: Label = 0;
    const storeKey = `mlv-beat-${model}`;
    const won = $('[data-role="won"]'), win = $('[data-role="win"]');
    if (cfg.target != null) {
      try { if (localStorage.getItem(storeKey)) won!.hidden = false; } catch { /* storage blocked: the goal still works */ }
    }

    const store = new Store({ testFrac: 0.25 });
    const undo = new UndoStack<Point>();
    const board = new Board($<HTMLCanvasElement>('canvas')!, store, {
      ...style,
      onAdd: cfg.target != null ? undefined : (p, e) => { undo.push(store.add(p.x, p.y, (e.shiftKey ? 1 - cls : cls) as Label)); syncUndo(); },
    });
    /** Undo is live while a point the viewer added is still in the data. */
    const syncUndo = () => {
      const can = undo.prune(p => store.points.includes(p)) > 0;
      $$('[data-role="undo"]').forEach(b => ((b as HTMLButtonElement).disabled = !can));
    };
    const refit = () => {
      const m = fitModel(model, params, store.train());
      board.setModel(m);
      const te = score(m, store.test());
      $$('[data-role="train"]').forEach(el => (el.textContent = pct(score(m, store.train()))));
      $$('[data-role="test"]').forEach(el => (el.textContent = pct(te)));
      syncUndo();
      if (cfg.target != null && te != null) {
        const reached = Math.round(te * 100) >= cfg.target;
        win!.hidden = !reached;
        if (reached) {
          won!.hidden = true;
          try { localStorage.setItem(storeKey, '1'); } catch { /* storage blocked: success just isn't remembered */ }
        }
      }
    };
    store.subscribe(refit);

    const slider = $<HTMLInputElement>('[data-role="param"]');
    if (slider && cfg.paramName) {
      const name = cfg.paramName;
      const showHint = () => {
        const v = params[name], { low, high } = cfg.hints;
        $('[data-role="hint"]')!.textContent = low && v <= low.max ? low.text : high && v >= high.min ? high.text : '';
      };
      slider.addEventListener('input', () => {
        params[name] = Number(slider.value);
        $('[data-role="pval"]')!.textContent = cfg.log ? String(Number((10 ** params[name]).toPrecision(2))) : slider.value;
        showHint();
        refit();
      });
      showHint();
    }

    mountPlayDock(root, () => { const p = undo.pop(q => store.points.includes(q)); if (p) store.remove(p); });

    if (cfg.target != null) { store.preset(cfg.preset, cfg.seed); continue; }
    const flip = $('[data-role="flip"]');
    const setCls = (c: Label) => {
      cls = c;
      $$('[data-cls]').forEach(x => { const on = Number(x.dataset.cls) === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
      const name = $(`[data-cls="${c}"] span:not(.swatch)`)!.textContent!;
      if (flip) {
        flip.querySelector('.swatch')!.className = `swatch ${c ? 'b' : 'a'}`;
        flip.querySelector('.nm')!.textContent = name;
        flip.setAttribute('aria-label', flip.dataset.label!.replace('{c}', name));
      }
    };
    $$('[data-cls]').forEach(b => b.addEventListener('click', () => setCls(Number(b.dataset.cls) as Label)));
    flip?.addEventListener('click', () => setCls((1 - cls) as Label));
    $$('[data-preset]').forEach(b => b.addEventListener('click', () => {
      const name = b.dataset.preset!;
      if (!isPreset(name)) return;
      store.preset(name);
      $$('[data-preset]').forEach(x => x.classList.toggle('on', x === b));
    }));
    $$('[data-role="resplit"]').forEach(b => b.addEventListener('click', () => store.resplit()));
    $$('[data-role="clear"]').forEach(b => b.addEventListener('click', () => {
      store.clear();
      $$('[data-preset]').forEach(x => x.classList.remove('on'));
    }));

    store.preset(cfg.preset, cfg.seed);
  }
</script>
