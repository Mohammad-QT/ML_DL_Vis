---
// Play tab of "Multiple linear regression": three inputs (two sliders and a one-hot state), the weights, and the dummy-variable trap.
// The weights are fixed and made up for the lesson: profit = 20 + 0.75 × R&D + 0.06 × marketing + a state adjustment (all in $ thousand).
interface Props { ui: Record<string, string> }
const { ui } = Astro.props;
---
<div class="multi" data-multi data-ui={JSON.stringify(ui)}>
  <div class="inputs">
    <label class="box"><span class="label">{ui.rd} · <b data-v="rd">$100k</b></span><input type="range" data-in="rd" min="0" max="200" step="5" value="100"></label>
    <label class="box"><span class="label">{ui.mk} · <b data-v="mk">$150k</b></span><input type="range" data-in="mk" min="0" max="400" step="10" value="150"></label>
    <div class="box"><span class="label">{ui.state}</span>
      <div class="chips"><button class="chip on" data-state="ca">{ui.ca}</button><button class="chip" data-state="ny">{ui.ny}</button><button class="chip" data-state="fl">{ui.fl}</button></div></div>
    <label class="box check"><input type="checkbox" data-trap> <span>{ui.trap_label}</span></label>
    <label class="box" data-shiftbox hidden><span class="label">{ui.shift} · <b data-v="shift">0</b></span><input type="range" data-in="shift" min="-20" max="20" step="1" value="0"></label>
  </div>
  <div class="calc">
    <table class="terms" aria-live="polite"><thead><tr><th>{ui.term}</th><th>{ui.value}</th><th>{ui.weight}</th><th>{ui.adds}</th></tr></thead><tbody data-rows></tbody>
      <tfoot><tr><td colspan="3">{ui.profit}</td><td><b data-total>–</b></td></tr></tfoot></table>
    <p class="note" data-note></p>
  </div>
</div>

<style is:global>
  .multi { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 20px; margin-top: 16px; }
  .multi .inputs { display: flex; flex-direction: column; gap: 12px; }
  .multi .box { display: block; background: var(--paper); border-radius: 14px; padding: 12px 14px; }
  .multi .box[hidden] { display: none; }
  .multi .box .label b { color: var(--ink); }
  .multi .box.check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; font-size: 14.5px; line-height: 1.35; }
  .multi .box.check input { margin-top: 3px; }
  .multi .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .multi .terms { width: 100%; border-collapse: collapse; background: var(--sheet); border: 1.5px solid var(--rule); border-radius: 14px; overflow: hidden; font: 500 15px var(--mono); }
  .multi .terms th { text-align: start; font: 600 12px var(--mono); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); background: var(--paper); padding: 8px 12px; }
  html[dir="rtl"] .multi .terms th { letter-spacing: 0; font-family: var(--body); }
  .multi .terms td { padding: 8px 12px; border-top: 1px solid var(--rule); white-space: nowrap; }
  .multi .terms td.nm { font-family: var(--body); font-weight: 700; white-space: normal; }
  .multi .terms td.off { color: var(--muted); }
  .multi .terms tfoot td { font: 600 18px var(--mono); background: var(--paper); }
  .multi .terms tfoot td:first-child { font-family: var(--body); font-weight: 700; }
  .multi .bar { display: inline-block; vertical-align: middle; height: 8px; border-radius: 9px; margin-inline-start: 8px; background: var(--a); }
  .multi .bar.neg { background: var(--b); }
  .multi .note { margin-top: 14px; max-width: 640px; border-inline-start: 4px solid var(--hl); padding: 2px 14px; }
  @media (max-width: 860px) {
    .multi { grid-template-columns: 1fr; }
    .multi .terms { font-size: 13px; } .multi .terms td, .multi .terms th { padding: 6px 7px; }
    .multi .terms th:nth-child(2), .multi .terms td:nth-child(2) { display: none; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-multi]')) {
    const ui: Record<string, string> = JSON.parse(root.dataset.ui!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const W = { b0: 20, rd: 0.75, mk: 0.06, ca: 0, ny: -4, fl: 3 };
    let rd = 100, mk = 150, state: 'ca' | 'ny' | 'fl' = 'ca', trap = false, shift = 0;
    const iso = (x: string) => `⁦${x}⁩`; // keeps "$" and "k" in order inside right-to-left text
    const k = (v: number) => iso(`$${Math.round(v * 10) / 10}k`);
    const sign = (v: number) => iso((v < 0 ? '−' : '+') + `$${Math.abs(Math.round(v * 10) / 10)}k`);
    const fmt = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, n) => v[n]);

    function render() {
      // each row: label, input value, weight, contribution, active
      const rows: Array<[string, string, string, number, boolean]> = [];
      const b0 = W.b0 - (trap ? shift : 0);
      rows.push([ui.intercept, '1', k(b0), b0, true]);
      rows.push([ui.rd, k(rd), String(W.rd), W.rd * rd, true]);
      rows.push([ui.mk, k(mk), String(W.mk), W.mk * mk, true]);
      const states = trap ? (['ca', 'ny', 'fl'] as const) : (['ny', 'fl'] as const);
      for (const s of states) {
        const w = W[s] + (trap ? shift : 0), on = state === s;
        rows.push([`${ui.state}: ${ui[s]}`, on ? '1' : '0', k(w), on ? w : 0, on]);
      }
      const total = rows.reduce((s, r) => s + r[3], 0);
      $('[data-rows]').innerHTML = rows.map(([n, x, w, c, on]) =>
        `<tr><td class="nm${on ? '' : ' off'}">${n}</td><td class="${on ? '' : 'off'}">${x}</td><td>${w}</td><td class="${on ? '' : 'off'}">${sign(c)}<span class="bar${c < 0 ? ' neg' : ''}" style="width:${Math.min(90, Math.abs(c) * 0.7)}px"></span></td></tr>`).join('');
      $('[data-total]').textContent = k(total);
      $('[data-note]').innerHTML = trap
        ? ui.trap_note
        : state === 'ca' ? ui.note_ca : fmt(ui.note_other, { s: ui[state], w: sign(W[state]) });
    }

    root.querySelectorAll<HTMLInputElement>('[data-in]').forEach(el => el.addEventListener('input', () => {
      const v = Number(el.value), n = el.dataset.in!;
      if (n === 'rd') { rd = v; $('[data-v="rd"]').textContent = k(v); }
      if (n === 'mk') { mk = v; $('[data-v="mk"]').textContent = k(v); }
      if (n === 'shift') { shift = v; $('[data-v="shift"]').textContent = String(v); }
      render();
    }));
    root.querySelectorAll<HTMLElement>('[data-state]').forEach(b => b.addEventListener('click', () => {
      state = b.dataset.state as typeof state;
      root.querySelectorAll('[data-state]').forEach(x => x.classList.toggle('on', x === b));
      render();
    }));
    $<HTMLInputElement>('[data-trap]').addEventListener('change', e => {
      trap = (e.target as HTMLInputElement).checked;
      $('[data-shiftbox]').hidden = !trap;
      if (!trap) { shift = 0; $<HTMLInputElement>('[data-in="shift"]').value = '0'; $('[data-v="shift"]').textContent = '0'; }
      render();
    });
    render();
  }
</script>
