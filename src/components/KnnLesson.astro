---
// Placeholder K-NN lesson (Milestone 1). Milestone 3 turns this into the MDX-driven lesson template.
import Base from '../layouts/Base.astro';
import Board from './Board.astro';
import { href, knnLesson, common, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = { ...common[lang], ...knnLesson[lang] };
const steps = [t.s1, t.s2, t.s3, t.s4];
---
<Base lang={lang} title={t.page_title} description={t.lede}>
  <nav class="crumbs" slot="crumbs"><a href={href(lang)}>{t.nav_course}</a> / <span>{t.crumb_part}</span></nav>
  <div class="progress" slot="bar"><span>{t.progress}</span><span class="track"><i data-pbar></i></span></div>

  <section class="hero">
    <div>
      <div class="kicker">{t.kicker}</div>
      <h1 class="display" set:html={t.title} />
      <p class="lede">{t.lede}</p>
    </div>
    <figure class="sheet fp">
      <Board lang={lang} model="knn" variant="figure" preset="moons" seed={11} cell={4} dot={3.6} tint={0.24} />
      <figcaption><span>{t.fp_cap}</span> <b>{t.s_knn}</b></figcaption>
    </figure>
  </section>

  <div class="tabs" role="tablist">
    {steps.map((s, i) => (
      <button class:list={['tab', { on: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-step={i}><span class="n">{i + 1}</span><span>{s}</span></button>
    ))}
  </div>

  <section class="sheet card on" role="tabpanel">
    <div class="read">
      <h2 class="display">{t.idea_h}</h2>
      <p set:html={t.idea_p} />
    </div>
    <h3 class="display">{t.steps_h}</h3>
    <ol class="how"><li set:html={t.step1} /><li>{t.step2}</li><li>{t.step3}</li><li>{t.step4}</li></ol>
    <div class="note read"><h3 class="display" style="margin-top:0">{t.scaling_h}</h3><p set:html={t.scaling_p} /></div>
    <div class="navrow"><span></span><button class="btn" data-goto="1"><span>{t.s2}</span> <span class="arr">→</span></button></div>
  </section>

  <section class="sheet card" role="tabpanel">
    <h2 class="display">{t.play_h}</h2>
    <p class="muted read">{t.play_p}</p>
    <Board lang={lang} model="knn" params={{ k: 5 }} preset="blobs" seed={3} paramLabel={t.p_k}
      hints={{ low: { max: 3, text: t.k_small }, high: { min: 15, text: t.k_big } }} />
    <div class="navrow"><button class="btn ghost" data-goto="0"><span class="arr">←</span> <span>{t.s1}</span></button><button class="btn" data-goto="2"><span>{t.s3}</span> <span class="arr">→</span></button></div>
  </section>

  <section class="sheet card" role="tabpanel">
    <div class="read">
      <h2 class="display">{t.quiz_h}</h2>
      <p class="q">{t.q1}</p>
      <button class="ans" data-ans="a1"><span>{t.a1}</span><span class="tag"></span></button>
      <button class="ans" data-ans="a2"><span>{t.a2}</span><span class="tag"></span></button>
      <button class="ans" data-ans="a3"><span>{t.a3}</span><span class="tag"></span></button>
      <p class="fb" aria-live="polite" data-fb data-right={t.right} data-wrong={t.wrong}></p>
    </div>
    <div class="navrow"><button class="btn ghost" data-goto="1"><span class="arr">←</span> <span>{t.s2}</span></button><button class="btn" data-goto="3"><span>{t.s4}</span> <span class="arr">→</span></button></div>
  </section>

  <section class="sheet card" role="tabpanel">
    <div class="read">
      <h2 class="display">{t.code_h}</h2>
      <p class="muted">{t.code_p}</p>
<pre><span class="k">from</span> sklearn.neighbors <span class="k">import</span> KNeighborsClassifier
classifier = KNeighborsClassifier(n_neighbors=<span class="n">5</span>)
classifier.fit(X_train, y_train)
y_pred = classifier.predict(X_test)</pre>
      <div class="codecta">
        <a class="btn hl" href="#colab" data-colab><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 7h10v10M7 17 17 7"/></svg><span>{t.colab}</span></a>
        <a class="btn ghost" href={href(lang, 'compare/?a=knn&b=ksvm')}><span>{t.compare_cta}</span> <span class="arr">→</span></a>
      </div>
    </div>
    <div class="navrow"><button class="btn ghost" data-goto="2"><span class="arr">←</span> <span>{t.s3}</span></button><button class="btn"><span>{t.next}</span> <span class="arr">→</span></button></div>
  </section>

  <div id="toast" slot="after" role="status">{t.colab_toast}</div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: end; padding: 26px 0 30px; }
  .kicker { font: 600 13px var(--mono); color: var(--muted); }
  h1 { font-size: 68px; line-height: .98; margin: 12px 0 14px; }
  .lede { font-size: 20px; color: var(--muted); max-width: 30em; }
  .fp { padding: 12px; transform: rotate(1.2deg); }
  :global(html[dir="rtl"]) .fp { transform: rotate(-1.2deg); }
  .fp figcaption { font: 500 13px var(--mono); color: var(--muted); padding: 10px 4px 2px; }
  .fp figcaption b { color: var(--ink); font-family: var(--body); font-size: 15px; }

  .progress { display: flex; align-items: center; gap: 10px; font: 500 12px var(--mono); color: var(--muted); }
  .progress .track { width: 120px; height: 6px; border-radius: 9px; background: var(--rule); overflow: hidden; }
  .progress .track i { display: block; height: 100%; width: 28%; background: var(--ok); border-radius: 9px; transition: width .4s; }

  .tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .tab { display: flex; align-items: center; gap: 9px; border: 1.5px solid var(--rule); background: var(--sheet); color: var(--muted); font: 700 16px var(--body); padding: 8px 18px 8px 9px; border-radius: 13px; cursor: pointer; box-shadow: 0 3px 0 var(--lift); transition: transform .12s; }
  :global(html[dir="rtl"]) .tab { padding: 8px 9px 8px 18px; }
  .tab:hover { transform: translateY(-2px); }
  .tab .n { width: 25px; height: 25px; border-radius: 8px; display: grid; place-items: center; font: 600 13px var(--mono); background: var(--paper); }
  .tab.on { background: var(--ink); color: var(--sheet); border-color: var(--ink); }
  .tab.on .n { background: var(--hl); color: #15202b; }
  .tab.done .n { background: var(--ok); color: #fff; }

  .card { display: none; padding: 34px 36px; }
  .card.on { display: block; animation: rise .3s ease; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  .card h2 { font-size: 34px; line-height: 1.1; margin-bottom: 12px; }
  .card h3 { font-size: 21px; margin: 26px 0 10px; }
  .read { max-width: 640px; }
  .read p { margin-bottom: 12px; }
  .card :global(code) { font: 500 .86em var(--mono); background: var(--paper); padding: 1px 6px; border-radius: 5px; }
  .how { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; counter-reset: s; }
  .how li { counter-increment: s; background: var(--paper); border-radius: 14px; padding: 14px; font-size: 15.5px; line-height: 1.45; }
  .how li::before { content: counter(s); display: block; font: 600 13px var(--mono); color: var(--muted); margin-bottom: 6px; }
  .note { margin-top: 22px; border-inline-start: 4px solid var(--hl); padding: 4px 0 4px 16px; }
  :global(html[dir="rtl"]) .note { padding: 4px 16px 4px 0; }

  .q { font: 700 21px/1.35 var(--body); margin-bottom: 8px; }
  .ans { display: block; width: 100%; text-align: start; border: 1.5px solid var(--rule); background: var(--sheet); color: var(--ink); border-radius: 14px; padding: 14px 18px; margin: 10px 0; font: 700 16.5px var(--body); cursor: pointer; box-shadow: 0 3px 0 var(--lift); transition: transform .12s; }
  .ans:hover { transform: translateY(-2px); }
  .ans.right { border-color: var(--ok); box-shadow: 0 3px 0 var(--ok); }
  .ans.wrong { border-color: var(--bad); box-shadow: 0 3px 0 var(--bad); }
  .ans .tag { float: inline-end; font: 600 12px var(--mono); }
  .ans.right .tag { color: var(--ok); } .ans.wrong .tag { color: var(--bad); }
  .fb { margin-top: 8px; font-size: 16.5px; }

  .codecta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .navrow { display: flex; justify-content: space-between; margin-top: 28px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; } h1 { font-size: 46px; }
    .how { grid-template-columns: 1fr 1fr; }
    .card { padding: 22px; } .progress { display: none; }
    :global(.crumbs) { display: none; }
  }
</style>

<script>
  const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
  const tabs = $$('.tab'), cards = $$('.card');
  const pbar = document.querySelector<HTMLElement>('[data-pbar]');
  const lit = (el: HTMLElement) => { el.classList.remove('lit'); requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('lit'))); };

  function go(i: number) {
    tabs.forEach((t, j) => { t.classList.toggle('on', j === i); t.setAttribute('aria-selected', String(j === i)); if (j < i) t.classList.add('done'); });
    cards.forEach((c, j) => c.classList.toggle('on', j === i));
    lit(cards[i]);
    if (pbar) pbar.style.width = `${28 + i * 4}%`;
  }
  tabs.forEach(t => t.addEventListener('click', () => go(Number(t.dataset.step))));
  $$('[data-goto]').forEach(b => b.addEventListener('click', () => go(Number(b.dataset.goto))));

  const fb = document.querySelector<HTMLElement>('[data-fb]')!;
  $$('.ans').forEach(b => b.addEventListener('click', () => {
    const ok = b.dataset.ans === 'a1';
    $$('.ans').forEach(x => { x.classList.remove('right', 'wrong'); x.querySelector('.tag')!.textContent = ''; });
    b.classList.add(ok ? 'right' : 'wrong');
    b.querySelector('.tag')!.textContent = ok ? '✓' : '✗';
    fb.innerHTML = (ok ? fb.dataset.right : fb.dataset.wrong) ?? '';
    lit(fb);
  }));

  const toast = document.getElementById('toast');
  $$('[data-colab]').forEach(a => a.addEventListener('click', e => {
    e.preventDefault();
    toast?.classList.add('show');
    setTimeout(() => toast?.classList.remove('show'), 2200);
  }));

  go(0);
</script>
