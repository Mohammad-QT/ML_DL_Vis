---
interface Props { kicker: string; title: string; lede: string }
const { kicker, title, lede } = Astro.props;
---
<section class="hero">
  <div>
    <div class="kicker">{kicker}</div>
    <h1 class="display" set:html={title} />
    <p class="lede">{lede}</p>
  </div>
  <figure class="sheet fp"><slot /></figure>
</section>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: end; padding: 26px 0 30px; }
  .kicker { font: 600 13px var(--mono); color: var(--muted); }
  h1 { font-size: 68px; line-height: .98; margin: 12px 0 14px; overflow-wrap: anywhere; }
  .lede { font-size: 20px; color: var(--muted); max-width: 30em; }
  .fp { padding: 12px; transform: rotate(1.2deg); }
  :global(html[dir="rtl"]) .fp { transform: rotate(-1.2deg); }
  .fp > :global(figcaption) { font: 500 13px var(--mono); color: var(--muted); padding: 10px 4px 2px; }
  .fp > :global(figcaption b) { color: var(--ink); font-family: var(--body); font-size: 15px; }

  .hero.compact { grid-template-columns: minmax(0, 1fr); padding-block: 12px 16px; }
  .compact h1 { font-size: 30px; margin: 4px 0 0; }
  .compact .lede, .compact .fp { display: none; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: 46px; }
    .compact h1 { font-size: 24px; }
  }
</style>
