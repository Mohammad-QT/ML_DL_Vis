---
import '../styles/fonts.css';
import '../styles/theme.css';
import { common, href, parsePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const t = common[lang];
const parsed = parsePath(Astro.url.pathname);
const path = parsed.path.startsWith('404') ? '' : parsed.path; // the 404 page has no language twin
const desc = description ? description.replace(/<[^>]+>/g, '').slice(0, 200) : t.site_desc;
const full = `${title} · ${t.brand}`;
const canonical = new URL(href(lang, path), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const og = new URL(`${base}og.png`, Astro.site);
const icon = `${base}favicon.svg`;
const rail = Astro.slots.has('rail');
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'} data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{full}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href={icon}>
  <meta name="theme-color" content="#0d161e">
  <meta property="og:type" content="website"><meta property="og:site_name" content={t.brand}>
  <meta property="og:title" content={full}><meta property="og:description" content={desc}>
  <meta property="og:url" content={canonical}><meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:locale" content={lang === 'ar' ? 'ar' : 'en'}>
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('mlv-theme')||'dark'}catch(e){document.documentElement.dataset.theme='dark'}</script>
  <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)}>
  <link rel="alternate" hreflang="ar" href={new URL(href('ar', path), Astro.site)}>
  <link rel="alternate" hreflang="x-default" href={new URL(href('en', path), Astro.site)}>
  <link rel="manifest" href={`${base}manifest.webmanifest`}>
  <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`}>
  <script is:inline>addEventListener('beforeinstallprompt',function(e){e.preventDefault();window.__mlvInstall=e;dispatchEvent(new Event('mlv:installable'))})</script>
</head>
<body class:list={{ 'has-rail': rail }}>
<a class="skip" href="#main">{t.skip}</a>
<div class="wrap">
  <header class="topbar">
    <a class="brand" href={href(lang)}><svg viewBox="0 0 28 28" aria-hidden="true"><rect x="1.5" y="1.5" width="25" height="25" rx="7" fill="var(--sheet)" stroke="var(--ink)" stroke-width="1.5"/><path d="M5 20 C10 19 11 9 23 7" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="10" r="2.3" fill="var(--a)"/><circle cx="19" cy="19" r="2.3" fill="var(--b)"/></svg><span>{t.brand}</span></a>
    {rail && <button class="coursebtn" type="button" data-rail-open aria-controls="rail" aria-expanded="false" aria-label={t.nav_course}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span>{t.nav_course}</span></button>}
    <slot name="crumbs" />
    <div class="spacer"></div>
    <slot name="bar" />
    <nav class="seg" aria-label={t.lang_switch}>
      <a href={href('en', path)} hreflang="en" lang="en" class:list={{ on: lang === 'en' }} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      <a href={href('ar', path)} hreflang="ar" lang="ar" class:list={{ on: lang === 'ar' }} aria-current={lang === 'ar' ? 'true' : undefined}>ع</a>
    </nav>
    <button class="iconbtn" data-theme-toggle aria-label={t.theme_toggle}><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </header>
  {rail
    ? <div class="withrail"><slot name="rail" /><main id="main" tabindex="-1"><slot /></main></div>
    : <main id="main" tabindex="-1"><slot /></main>}
  <footer class="site-foot">{t.copyright}</footer>
</div>
<slot name="after" />
<script>
  document.querySelectorAll('[data-theme-toggle]').forEach(b => b.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('mlv-theme', next); } catch { /* storage blocked: theme still switches */ }
    dispatchEvent(new Event('themechange'));
  }));
  // keep page state such as Compare's ?a=&b= when switching language
  document.querySelectorAll<HTMLAnchorElement>('.seg a').forEach(a => a.addEventListener('click', () => {
    a.href = a.href.split(/[?#]/)[0] + location.search;
  }));
  // offline app: the service worker exists only in production builds (see integrations/pwa.mjs)
  if ('serviceWorker' in navigator && import.meta.env.PROD) {
    addEventListener('load', () => {
      navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}sw.js`).catch(() => { /* offline mode is optional */ });
    });
  }
</script>
</body>
</html>

<style>
  .coursebtn { display: none; align-items: center; gap: 7px; height: 34px; padding: 0 12px; border: 1.5px solid var(--rule); background: var(--sheet); color: var(--ink); border-radius: 10px; font: 700 14px var(--body); cursor: pointer; box-shadow: 0 3px 0 var(--lift); }
  .coursebtn:hover { border-color: var(--muted); }
  .has-rail .wrap { max-width: 1360px; }
  .withrail { display: grid; grid-template-columns: 252px minmax(0, 1fr); gap: 30px; align-items: start; }
  .withrail > main { min-width: 0; }
  @media (max-width: 1099px) {
    .has-rail .wrap { max-width: 1060px; }
    .withrail { display: block; }
    .coursebtn { display: inline-flex; }
  }
  @media (max-width: 480px) { .coursebtn span { display: none; } .coursebtn { padding: 0 9px; } .brand span { white-space: nowrap; } }
</style>
